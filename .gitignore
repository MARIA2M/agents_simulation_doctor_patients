# ── Python ───────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# ── Environments ─────────────────────────────
venv*/
.venv/
.env

# ── Run outputs ──────────────────────────────
# Every run carries its own run_meta.json with the git commit that produced
# it (§3.2), so outputs do not need to live in the repository. The directory
# itself is kept so a fresh clone can write runs without creating it first.
runs/*
!runs/.gitkeep

# ── Frontend ─────────────────────────────────
node_modules/
dist/

# ── OS ───────────────────────────────────────
.DS_Store

# Los logs de SLURM: un fichero por trabajo, ninguno reproducible.
logs/
__pycache__/
*.pyc
