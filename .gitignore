# The two interpreters, rebuilt per machine from requirements.txt.
# venv-hpc.lock is tracked: it is what records the versions that produced
# the existing runs.
venv-local/
venv-hpc/

__pycache__/
*.py[cod]
.pytest_cache/

# Written by the queue, one file per job.
logs/
greasy_tasks/

# runs/ is deliberately NOT ignored: the batches ship with the repo so the
# viewer works on a fresh clone. Two consequences, both from the code:
#
#   1. run_batch.py refuses to start on a dirty tree, and a batch dirties the
#      tree as it writes. Launching now needs --allow-dirty, or a commit of
#      the previous batch first.
#   2. metadata.py reads git_commit and dirty from `git status --porcelain`
#      with a 60 s timeout — its own comment measures 24.7 s on GPFS for 20
#      files. With every transcript tracked that call gets slower, and on
#      timeout _command_output returns None and the run records no provenance
#      without saying so. Check metadata.json: git_commit null means this.
